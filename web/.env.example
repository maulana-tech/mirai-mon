# Monad Testnet
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_EXPLORER_URL=https://testnet.monadscan.com

# Mirai contract; defaults to the Monad testnet deployment. Set it empty to run the in-memory mock.
# VITE_MIRAI_ADDRESS=0xEAFFa1705b5cf69B291aa88484F9655Fe8341b83
# Defaults to AUSD on Monad testnet
# VITE_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC

# Optional Envio GraphQL endpoint (indexer/). Without it, activity shows only the last ~5 minutes.
VITE_INDEXER_URL=

# Server-only (Vercel env, never VITE_-prefixed): funded testnet key for /api/onboard
# DRIP_PRIVATE_KEY=0x...
# Server-only: Nansen API key for /api/market (Smart Money basket weights). Without it the basket keeps its on-chain weights.
# NANSEN_API_KEY=
